{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
